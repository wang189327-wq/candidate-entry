# 复制为 .env.local 后填入你自己的 Supabase 项目凭证（Web 版示例）
# 前端仅使用 anon key，请确保 Supabase 已正确配置 RLS 行级安全策略
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# 可选：管理员验证码的过渡期回退值（执行 supabase/migrations 后由服务端 verify_admin RPC 校验，
# 此变量仅在 RPC 未部署时生效）
# VITE_ADMIN_VERIFY_CODE=change-me

# 桌面版专用（service_role 密钥可绕过 RLS，仅在可信内网环境使用，切勿提交）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
