{
  "name": "candidate-entry",
  "version": "2.1.0",
  "description": "求职者信息录入工具 —— 聊天记录解析、SAP 岗位匹配、一键写入可插拔目标系统",
  "license": "MIT",
  "author": "Wang Mei <wang189327-wq@users.noreply.github.com>",
  "homepage": "https://wang189327-wq.github.io/candidate-entry/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wang189327-wq/candidate-entry.git"
  },
  "bugs": {
    "url": "https://github.com/wang189327-wq/candidate-entry/issues"
  },
  "keywords": [
    "react",
    "vite",
    "tailwind",
    "supabase",
    "recruitment",
    "automation",
    "webhook"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx",
    "lint:fix": "eslint src --ext .js,.jsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx}\" \"*.js\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\" \"*.js\" \"*.json\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "verify": "npm run lint && npm run format:check && npm run test && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "bcryptjs": "^3.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "^10.4.18",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "postcss": "^8.4.35",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.1",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  }
}
